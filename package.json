{
  "name": "coc-keeper",
  "version": "0.1.7",
  "description": "COC 7th Edition AI Keeper - AI 同时担任守密人与队友调查员",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/rules.test.mjs && node tests/unit.test.mjs && node tests/occupations.test.mjs && node tests/charStore.test.mjs && node tests/charGen.points.test.mjs && node tests/charEditor.smoke.mjs && node tests/gameSetup.smoke.mjs && node tests/messages.dom.test.mjs && node tests/ruleBook.test.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable && node tools/move-artifact.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "coc.keeper.ai",
    "productName": "COC跑团",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "assets/**/*",
      "src/**/*",
      "node_modules/fflate/**/*",
      "node_modules/pdf-parse/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}.${ext}"
    },
    "asarUnpack": [
      "assets/**/*"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-parse": "^2.4.5"
  }
}
