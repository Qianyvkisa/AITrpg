# ---------------------------------------------------------------------------
# 忽略规则
#
# 核心原则：仓库只存「源码」，不存「能重新生成的东西」和「本机私有数据」。
# 这个项目里最容易误提交的三类大文件都在下面。
# ---------------------------------------------------------------------------

# ---- 依赖与包管理器缓存 ----
node_modules/
.pnpm-store/

# ---- 打包产物（可由 pnpm dist 重新生成）----
# dist\ 里有 459 MB：win-unpacked 解压目录 + portable exe。
# 提交进去会让仓库膨胀到无法正常 clone/push。
dist/

# 根目录的成品 exe 也是打包产物，同样不入库
COC跑团.exe
*.exe

# ---- 运行时数据（含 API Key、存档、日志）----
# 存档与配置走 Electron 的 userData 目录，正常不在项目里；
# 但开发模式 start.ps1 会用 .udata 作为 user-data-dir，
# 那里的 data\config.json 可能存有 API Key，绝不能提交。
.udata/
*.log

# ---- 编辑器 / 系统临时文件 ----
.vscode/
.idea/
*.tmp
*.bak
*~
Thumbs.db
desktop.ini

# ---- 本地备份（样式调试时的临时副本）----
.backup/
*.before_clean
*.mojibake

# ---- 调试用临时脚本（我排查问题时生成的）----
_r.py
_r2.py
_*.mjs
_*.log
_*.txt
# 图像/规则书 OCR 排查时的临时工作目录（脚本 + 中间图，随时可删）
.tmp_zhitu/

# ---- 规则书 PDF（官方出版物，不入库）----
# assets/coc-kp.pdf 是《克苏鲁的呼唤》第七版的官方规则书，有版权，
# 不随源码分发。需要阅读功能时自己放一份到 assets/ 下即可；
# 缺文件时应用会提示，并给出「用系统阅读器打开」的退路。
assets/*.pdf
assets/coc-kp.pdf

# ---- 开发用的独立 Electron ----
# node_modules 里那份带 Windows Low 完整性标签，直接启动会返回 0x80000003；
# 排查界面问题时临时解压一份干净的到 .dev-electron/ 用。
# 它是 234 MB 的运行时，不入库。
.dev-electron/

# ---- 界面验证截图 ----
# tools/ui/shots 是跑截图工具时生成的产物（每张几百 KB，且可随时重跑）。
# 只保留脚本，不保留图片和报告。
tools/ui/shots/
